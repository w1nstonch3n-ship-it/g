[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/task_row.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="RowPanel"]
bg_color = Color(0.985, 0.946, 0.821, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.756, 0.65, 0.463, 1)

[node name="TaskRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 69)
layout_mode = 2
theme_override_styles/panel = SubResource("RowPanel")
script = ExtResource("1_script")

[node name="Padding" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_bottom = 4

[node name="Contents" type="HBoxContainer" parent="Padding"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Details" type="VBoxContainer" parent="Padding/Contents"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="TaskCheck" type="CheckBox" parent="Padding/Contents/Details"]
layout_mode = 2
clip_text = true
text = "Example task"

[node name="MetaLabel" type="Label" parent="Padding/Contents/Details"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "DUE TODAY"

[node name="Actions" type="VBoxContainer" parent="Padding/Contents"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="RewardLabel" type="Label" parent="Padding/Contents/Actions"]
layout_mode = 2
horizontal_alignment = 2
theme_override_font_sizes/font_size = 11
text = "+40"

[node name="RowButtons" type="HBoxContainer" parent="Padding/Contents/Actions"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="EditButton" type="Button" parent="Padding/Contents/Actions/RowButtons"]
custom_minimum_size = Vector2(39, 28)
layout_mode = 2
text = "EDIT"

[node name="DeleteButton" type="Button" parent="Padding/Contents/Actions/RowButtons"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
text = "X"
